<?php

/**
 * @file
 * Contains yudl_search.module.
 *
 * This module adds additional search funcationality to YUDL.
 */

use Drupal\search_api\IndexInterface;
use Drupal\search_api\Query\QueryInterface;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
function yudl_search_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.yudl_search':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('Custom search behaviour for YUDL.') . '</p>';
      return $output;
    default:
  }
}

/**
 * Implements hook_library_info_alter().
 */
function yudl_search_library_info_alter(&$libraries, $extension) {
  // jquery-ui-slider-pips needs jQuery.type(), which jQuery 4 removed.
  if ($extension === 'facets_range_widget') {
    foreach ($libraries as &$library) {
      $library['dependencies'][] = 'yudl_search/jquery_type_shim';
    }
  }
}
